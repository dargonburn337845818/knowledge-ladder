/* Nocturne Glassmorphism — 桌面端近似主题（Qt 不支持真背景模糊） */
* {
    font-family: "Georgia", "Songti SC", serif;
    color: #FFFFFF;
}

QMainWindow, QWidget#appShell, QWidget#appBody, QWidget#rightContainer {
    background: #0B1322;
}

QFrame#titleBar {
    background: #0B1322;
    border-bottom: 1px solid rgba(255,255,255,0.15);
}

QFrame#sidebar {
    background: #0E1828;
    border-right: 1px solid rgba(255,255,255,0.15);
}

QLabel#appTitle, QLabel#winTitle {
    background: transparent;
    color: #FFFFFF;
    font-family: Georgia, serif;
}

QPushButton {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 14px;
    color: #FFFFFF;
    padding: 8px 14px;
    font-family: Georgia, serif;
    font-size: 14px;
}

QPushButton:hover {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.3);
}

QPushButton:pressed {
    background: rgba(255,255,255,0.10);
}

QPushButton#dissectBtn, QPushButton#infoBtn, QPushButton#templateBtn {
    background: rgba(255,255,255,0.06);
    border-radius: 16px;
    color: #F3DCA8;
    border: 1px solid rgba(228,184,99,0.35);
    margin-top: 8px;
    font-size: 14px;
}

QPushButton#dissectBtn:hover, QPushButton#infoBtn:hover, QPushButton#templateBtn:hover {
    background: rgba(228,184,99,0.12);
    border-color: rgba(228,184,99,0.55);
}

QListWidget#tierList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#tierList::item {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 10px 8px;
    margin: 4px 2px;
    color: #FFFFFF;
}

QListWidget#tierList::item:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.3);
}

QListWidget#tierList::item:selected {
    background: rgba(228,184,99,0.14);
    border: 1px solid rgba(228,184,99,0.5);
    color: #F3DCA8;
}

QProgressBar#tierProgress {
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: 8px;
    color: #E4B863;
    height: 6px;
}

QProgressBar#tierProgress::chunk {
    background: #E4B863;
    border-radius: 8px;
}

QLabel#phaseLabel {
    color: rgba(255,255,255,0.6);
    font-size: 13px;
    font-style: italic;
}

QLabel#tagName {
    font-family: Georgia, serif;
    font-size: 16px;
    color: #FFFFFF;
}

QLabel#tagDesc {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
}

QFrame#tagRow {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    margin: 4px 0;
}

QLabel#infoBadge, QLabel#infoBadgeTopo, QLabel#infoBadgeDyn {
    background: rgba(228,184,99,0.12);
    border: 1px solid rgba(228,184,99,0.35);
    border-radius: 10px;
    color: #F3DCA8;
    font-size: 10px;
    padding: 3px 8px;
}

QPushButton#infoFilterBtn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    padding: 6px 12px;
    color: rgba(255,255,255,0.8);
    font-size: 12px;
}

QPushButton#infoFilterBtn:checked {
    background: rgba(228,184,99,0.14);
    border-color: rgba(228,184,99,0.5);
    color: #F3DCA8;
}

QDialog {
    background: #0B1322;
}

QLabel#pathLabel, QLabel#complexityLabel {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
}

QLabel#algName, QLabel#modalTitle {
    font-family: Georgia, serif;
    font-size: 20px;
    color: #F3DCA8;
}

QLabel#infoText {
    color: #E4B863;
    font-size: 13px;
}

QLabel#infoWhy {
    color: rgba(255,255,255,0.7);
    font-size: 13px;
}

QPlainTextEdit#codeView {
    background: #0E1828;
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    font-family: "Courier New", monospace;
}

QTextBrowser#guideBrowser {
    background: #0E1828;
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 16px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 6px;
    background: rgba(255,255,255,0.08);
}

QCheckBox::indicator:checked {
    background: #E4B863;
    border-color: #E4B863;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* 拆题页 */
QLabel#dissectStep {
    color: #E4B863;
    font-size: 14px;
    letter-spacing: 2px;
}

QPushButton#dissectBack, QPushButton#dissectRestart {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 14px;
    color: #FFFFFF;
}

QLabel#dissectTitle {
    font-family: Georgia, serif;
    font-size: 34px;
    color: #FFFFFF;
}

QLabel#dissectHint {
    color: rgba(255,255,255,0.6);
    font-style: italic;
    font-size: 14px;
}

QPushButton#dissectOption {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 18px;
    color: #FFFFFF;
    text-align: left;
    font-size: 16px;
    padding: 14px 18px;
    margin: 4px 0;
}

QPushButton#dissectOption:hover {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.35);
}

QLabel#dissectResultTitle, QLabel#dissectThinkingTitle {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #F3DCA8;
}

QLabel#dissectNode {
    font-size: 16px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 12px 16px;
    margin: 4px 0;
}

QPushButton#dissectOps {
    background: rgba(228,184,99,0.12);
    border: 1px solid rgba(228,184,99,0.4);
    border-radius: 16px;
    color: #F3DCA8;
    text-align: left;
    font-size: 15px;
    padding: 12px 16px;
}

QPushButton#dissectNext {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 16px;
    padding: 14px;
    margin-top: 12px;
}

QLabel#dissectThinkCard {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 14px 16px;
    font-size: 15px;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    margin: 6px 0;
}

QLabel#dissectFinal {
    background: rgba(228,184,99,0.10);
    border: 1px solid rgba(228,184,99,0.35);
    border-radius: 18px;
    padding: 14px 16px;
    font-size: 17px;
    color: #F3DCA8;
    margin-top: 10px;
}

QLabel#miniNote {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    font-style: italic;
    padding: 6px 4px;
}
