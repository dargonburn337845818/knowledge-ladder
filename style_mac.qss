/* Parallax Editorial 桌面端主题 */
* {
    font-family: "Georgia", "Songti SC", serif;
    color: #1a1712;
}

QWidget {
    background: #F5F0E6;
}

QMainWindow, QWidget#appShell, QWidget#appBody, QWidget#rightContainer {
    background: #F5F0E6;
}

QFrame#titleBar {
    background: #F5F0E6;
    border-bottom: 1px solid rgba(26,23,18,0.2);
}

QFrame#sidebar {
    background: #EBE3D3;
    border-right: 1px solid rgba(26,23,18,0.2);
}

QLabel#appTitle, QLabel#winTitle {
    color: #1a1712;
    background: transparent;
    font-family: "Fraunces", "Georgia", serif;
}

QPushButton {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(26,23,18,0.2);
    color: #1a1712;
    padding: 8px 10px;
    font-family: "Georgia", serif;
    font-size: 14px;
}

QPushButton:hover {
    color: #B3401F;
    border-bottom-color: #B3401F;
}

QPushButton:pressed {
    color: #B3401F;
}

QPushButton#dissectBtn, QPushButton#infoBtn {
    color: #B3401F;
    border-bottom: 1px solid #B3401F;
    font-size: 15px;
    font-weight: 400;
    padding: 10px 8px;
    margin-top: 6px;
}

QListWidget#tierList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#tierList::item {
    border-bottom: 1px solid rgba(26,23,18,0.2);
    padding: 10px 6px;
    color: #1a1712;
}

QListWidget#tierList::item:hover {
    color: #B3401F;
}

QListWidget#tierList::item:selected {
    color: #B3401F;
    background: transparent;
    border-bottom: 1px solid #B3401F;
}

QProgressBar#tierProgress {
    background: rgba(26,23,18,0.1);
    border: none;
    color: #B3401F;
    height: 5px;
}

QProgressBar#tierProgress::chunk {
    background: #B3401F;
}

QLabel#phaseLabel {
    font-size: 14px;
    color: rgba(26,23,18,0.7);
    font-style: italic;
}

QLabel#tagName {
    font-family: "Fraunces", "Georgia", serif;
    font-size: 16px;
    color: #1a1712;
}

QLabel#tagDesc {
    font-size: 12px;
    color: rgba(26,23,18,0.6);
}

QFrame#tagRow {
    background: transparent;
    border-bottom: 1px solid rgba(26,23,18,0.2);
}

QLabel#infoBadge, QLabel#infoBadgeTopo, QLabel#infoBadgeDyn {
    color: #B3401F;
    background: transparent;
    border-bottom: 1px solid #B3401F;
    font-size: 10px;
    padding: 2px 4px;
}

QPushButton#infoFilterBtn {
    border-bottom: 1px solid transparent;
    padding: 6px 10px;
    font-size: 12px;
}

QPushButton#infoFilterBtn:checked {
    color: #B3401F;
    border-bottom: 1px solid #B3401F;
}

QDialog {
    background: #F5F0E6;
}

QLabel#pathLabel, QLabel#complexityLabel {
    color: rgba(26,23,18,0.6);
    font-size: 12px;
}

QLabel#algName, QLabel#modalTitle {
    font-family: "Fraunces", "Georgia", serif;
    font-size: 20px;
}

QLabel#infoText {
    color: #B3401F;
    font-size: 13px;
}

QLabel#infoWhy {
    color: rgba(26,23,18,0.7);
    font-size: 13px;
}

QPlainTextEdit#codeView {
    background: #EBE3D3;
    color: #1a1712;
    border: 1px solid rgba(26,23,18,0.2);
    font-family: "Courier New", monospace;
}

QTextBrowser#guideBrowser {
    background: #F5F0E6;
    color: #1a1712;
    border: 1px solid rgba(26,23,18,0.2);
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(26,23,18,0.4);
    background: #F5F0E6;
}

QCheckBox::indicator:checked {
    background: #B3401F;
    border-color: #B3401F;
}

QScrollArea {
    background: transparent;
    border: none;
}

/* 拆题页 */
QLabel#dissectStep {
    color: #B3401F;
    font-size: 14px;
    letter-spacing: 2px;
}

QPushButton#dissectBack, QPushButton#dissectRestart {
    border-bottom: 1px solid #1a1712;
    color: #1a1712;
    font-size: 13px;
}

QLabel#dissectTitle {
    font-family: "Fraunces", "Georgia", serif;
    font-size: 34px;
    color: #1a1712;
}

QLabel#dissectHint {
    color: rgba(26,23,18,0.6);
    font-style: italic;
    font-size: 14px;
}

QPushButton#dissectOption {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(26,23,18,0.2);
    color: #1a1712;
    text-align: left;
    font-size: 16px;
    padding: 12px 4px;
}

QPushButton#dissectOption:hover {
    color: #B3401F;
    border-bottom-color: #B3401F;
}

QLabel#dissectResultTitle, QLabel#dissectThinkingTitle {
    font-family: "Fraunces", "Georgia", serif;
    font-size: 28px;
    color: #1a1712;
    border-top: 1px solid rgba(26,23,18,0.2);
    padding-top: 16px;
}

QLabel#dissectNode {
    font-size: 16px;
    border-bottom: 1px solid rgba(26,23,18,0.2);
    padding: 8px 2px;
}

QPushButton#dissectOps {
    color: #B3401F;
    border-bottom: 1px solid #B3401F;
    text-align: left;
    font-size: 15px;
}

QPushButton#dissectNext {
    border-top: 1px solid #1a1712;
    border-bottom: 1px solid #1a1712;
    color: #1a1712;
    font-size: 16px;
    margin-top: 12px;
}

QLabel#dissectThinkCard {
    border-top: 1px solid rgba(26,23,18,0.2);
    padding-top: 12px;
    font-size: 15px;
    color: rgba(26,23,18,0.85);
    line-height: 1.7;
}

QLabel#dissectFinal {
    border-top: 1px solid #1a1712;
    padding-top: 12px;
    font-size: 17px;
    color: #B3401F;
    margin-top: 10px;
}

QPushButton#templateBtn {
    color: #1a1712;
    border-bottom: 1px solid rgba(26,23,18,0.4);
    font-size: 14px;
    padding: 10px 8px;
    margin-top: 6px;
}

QPushButton#templateBtn:hover {
    color: #B3401F;
    border-bottom-color: #B3401F;
}
