/* Light Acrylic — 轻薄亚克力（无夜景） */
* {
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    color: #1A1C22;
}

QMainWindow, QWidget#appShell, QWidget#appBody, QWidget#rightContainer {
    background: #EEF1F6;
}

QFrame#titleBar {
    background: rgba(255,255,255,0.72);
    border-bottom: 1px solid rgba(0,0,0,0.08);
}

QFrame#sidebar {
    background: rgba(255,255,255,0.55);
    border-right: 1px solid rgba(0,0,0,0.08);
}

QLabel#appTitle, QLabel#winTitle {
    background: transparent;
    color: #1A1C22;
    font-family: "Segoe UI", sans-serif;
}

QPushButton {
    background: rgba(255,255,255,0.62);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    color: #1A1C22;
    padding: 8px 14px;
    font-size: 14px;
}

QPushButton:hover {
    background: rgba(255,255,255,0.9);
    border-color: rgba(0,0,0,0.16);
    color: #111;
}

QPushButton:pressed {
    background: rgba(255,255,255,0.7);
}

QPushButton#dissectNext,
QPushButton#dissectRestart,
QPushButton#next {
    background: rgba(76,110,245,0.12);
    border: 1px solid rgba(76,110,245,0.35);
    color: #3B5BDB;
}

QPushButton#dissectNext:hover,
QPushButton#dissectRestart:hover,
QPushButton#next:hover {
    background: rgba(76,110,245,0.18);
    border-color: rgba(76,110,245,0.6);
}

QPushButton#dissectBtn, QPushButton#infoBtn, QPushButton#templateBtn {
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 14px;
    color: #3B5BDB;
    margin-top: 8px;
    font-size: 14px;
}

QPushButton#dissectBtn:hover, QPushButton#infoBtn:hover, QPushButton#templateBtn:hover {
    background: rgba(255,255,255,0.9);
    border-color: rgba(76,110,245,0.45);
}

QListWidget#tierList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#tierList::item {
    background: rgba(255,255,255,0.5);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    padding: 10px 8px;
    margin: 4px 2px;
    color: #1A1C22;
}

QListWidget#tierList::item:hover {
    background: rgba(255,255,255,0.85);
    border-color: rgba(0,0,0,0.12);
}

QListWidget#tierList::item:selected {
    background: rgba(76,110,245,0.12);
    border: 1px solid rgba(76,110,245,0.4);
    color: #3B5BDB;
}

QProgressBar#tierProgress {
    background: rgba(0,0,0,0.06);
    border: none;
    border-radius: 8px;
    height: 6px;
}

QProgressBar#tierProgress::chunk {
    background: #4C6EF5;
    border-radius: 8px;
}

QLabel#phaseLabel {
    color: #6B7280;
    font-size: 13px;
    font-style: italic;
}

QLabel#tagName {
    font-weight: 600;
    font-size: 16px;
    color: #1A1C22;
}

QLabel#tagDesc {
    color: #6B7280;
    font-size: 12px;
}

QFrame#tagRow {
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 14px;
    margin: 4px 0;
}

QLabel#infoBadge, QLabel#infoBadgeTopo, QLabel#infoBadgeDyn {
    background: rgba(76,110,245,0.10);
    border: 1px solid rgba(76,110,245,0.25);
    border-radius: 8px;
    color: #3B5BDB;
    font-size: 10px;
    padding: 3px 8px;
}

QPushButton#infoFilterBtn {
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 10px;
    padding: 6px 12px;
    color: #4B5563;
    font-size: 12px;
}

QPushButton#infoFilterBtn:checked {
    background: rgba(76,110,245,0.12);
    border-color: rgba(76,110,245,0.45);
    color: #3B5BDB;
}

QDialog {
    background: #EEF1F6;
}

QLabel#pathLabel, QLabel#complexityLabel {
    color: #6B7280;
    font-size: 12px;
}

QLabel#algName, QLabel#modalTitle {
    font-size: 20px;
    color: #1A1C22;
}

QLabel#infoText {
    color: #3B5BDB;
    font-size: 13px;
}

QLabel#infoWhy {
    color: #4B5563;
    font-size: 13px;
}

QPlainTextEdit#codeView {
    background: rgba(255,255,255,0.8);
    color: #1A1C22;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 10px;
    font-family: "Consolas", "Courier New", monospace;
}

QTextBrowser#guideBrowser {
    background: rgba(255,255,255,0.8);
    color: #1A1C22;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 12px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(0,0,0,0.25);
    border-radius: 5px;
    background: rgba(255,255,255,0.7);
}

QCheckBox::indicator:checked {
    background: #4C6EF5;
    border-color: #4C6EF5;
}

QScrollArea {
    background: transparent;
    border: none;
}

QLabel#dissectStep {
    color: #3B5BDB;
    font-size: 14px;
    letter-spacing: 2px;
}

QPushButton#dissectBack {
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 12px;
    color: #1A1C22;
}

QLabel#dissectTitle {
    font-size: 32px;
    color: #1A1C22;
}

QLabel#dissectHint {
    color: #6B7280;
    font-style: italic;
    font-size: 14px;
}

QPushButton#dissectOption {
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    color: #1A1C22;
    text-align: left;
    font-size: 16px;
    padding: 14px 18px;
    margin: 4px 0;
}

QPushButton#dissectOption:hover {
    background: rgba(255,255,255,0.9);
    border-color: rgba(76,110,245,0.4);
    color: #3B5BDB;
}

QLabel#dissectResultTitle, QLabel#dissectThinkingTitle {
    font-size: 26px;
    color: #1A1C22;
}

QLabel#dissectNode {
    font-size: 16px;
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 14px;
    padding: 12px 16px;
    margin: 4px 0;
}

QPushButton#dissectOps {
    background: rgba(76,110,245,0.08);
    border: 1px solid rgba(76,110,245,0.3);
    border-radius: 14px;
    color: #3B5BDB;
    text-align: left;
    font-size: 15px;
    padding: 12px 16px;
}

QLabel#dissectThinkCard {
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 14px;
    padding: 14px 16px;
    font-size: 15px;
    color: #374151;
    line-height: 1.7;
    margin: 6px 0;
}

QLabel#dissectFinal {
    background: rgba(76,110,245,0.07);
    border: 1px solid rgba(76,110,245,0.28);
    border-radius: 14px;
    padding: 14px 16px;
    font-size: 17px;
    color: #3B5BDB;
    margin-top: 10px;
}

QLabel#miniNote {
    color: #6B7280;
    font-size: 12px;
    font-style: italic;
    padding: 6px 4px;
}
